#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Riga di comando di EMP Core. Usata dall'installer di EMP Server (emp-server).
 *
 *   emp piano      [id …]                  mostra l'ordine di installazione
 *   emp installa   --utente=NOME [id …]    installa/aggiorna Core e plugin
 *   emp disinstalla --utente=NOME id       rimuove un plugin dal registro (i dati restano)
 *   emp elenco                             moduli installati
 *   emp codice-setup                       codice monouso per il primo setup da un'altra postazione
 *   emp recupero-tecnico --tecnico=NOME    nuova password del Tecnico (letta da tastiera) e nuova Recovery Key
 *
 * Uscita: 0 riuscito, 1 errore, 2 uso errato. Output JSON con --json.
 */
if (PHP_SAPI !== 'cli') {
    exit(2);
}
require dirname(__DIR__) . '/src/bootstrap.php';

use Emp\Core\Config;
use Emp\Core\Module\Registry;
use Emp\Core\Module\Resolver;

$args = array_slice($argv, 1);
$command = array_shift($args) ?? '';
$json = false;
$actor = '';
$tecnico = '';
$ids = [];
foreach ($args as $arg) {
    if ($arg === '--json') {
        $json = true;
    } elseif (str_starts_with($arg, '--utente=')) {
        $actor = substr($arg, 9);
    } elseif (str_starts_with($arg, '--tecnico=')) {
        $tecnico = substr($arg, 10);
    } elseif (preg_match('/^[a-z][a-z0-9-]{2,63}$/', $arg)) {
        $ids[] = $arg;
    } else {
        fwrite(STDERR, "Argomento non valido: {$arg}\n");
        exit(2);
    }
}

$out = static function (bool $ok, array $lines) use ($json): never {
    if ($json) {
        echo json_encode(['ok' => $ok, 'messaggi' => $lines], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
    } else {
        fwrite($ok ? STDOUT : STDERR, implode("\n", $lines) . "\n");
    }
    exit($ok ? 0 : 1);
};

// Lettura di un segreto senza eco sul terminale (da una pipe: una riga).
$readSecret = static function (string $prompt): string {
    $tty = stream_isatty(STDIN);
    if ($tty) {
        fwrite(STDERR, $prompt);
        shell_exec('stty -echo');
    }
    $line = fgets(STDIN);
    if ($tty) {
        shell_exec('stty echo');
        fwrite(STDERR, "\n");
    }

    return rtrim((string) $line, "\r\n");
};

try {
    $config = Config::load();
    $available = (new Registry($config->modulesDir()))->discover();
    $selected = $ids === [] ? null : $ids;

    switch ($command) {
        case 'piano':
            $plan = (new Resolver())->resolve($available, $selected);
            $out(true, array_map(static fn ($m): string => "{$m->id} {$m->version}", $plan));
            // no break: $out termina
        case 'installa':
            if ($actor === '') {
                fwrite(STDERR, "Indicare --utente=NOME (tracciabilità)\n");
                exit(2);
            }
            $plan = (new Resolver())->resolve($available, $selected);
            $out(true, $config->installer()->install($plan, $actor));
            // no break
        case 'disinstalla':
            if ($actor === '' || count($ids) !== 1) {
                fwrite(STDERR, "Uso: emp disinstalla --utente=NOME id\n");
                exit(2);
            }
            $config->installer()->uninstall($ids[0], $available, $actor);
            $out(true, ["Rimosso {$ids[0]} dal registro. I dati non sono stati cancellati."]);
            // no break
        case 'elenco':
            $lines = [];
            foreach ($config->installer()->installed() as $id => $version) {
                $lines[] = "{$id} {$version}";
            }
            $out(true, $lines);
            // no break
        case 'codice-setup':
            $code = $config->kernel()->access()->createSetupCode('console');
            $out(true, [
                "Codice di setup: {$code}",
                'Valido ' . Emp\Core\Access\AccessService::SETUP_CODE_HOURS . ' ore, una sola volta. Generarne uno nuovo annulla il precedente.',
            ]);
            // no break
        case 'recupero-tecnico':
            if ($tecnico === '') {
                fwrite(STDERR, "Uso: emp recupero-tecnico --tecnico=NOME\n");
                exit(2);
            }
            $password = $readSecret('Nuova password del Tecnico (almeno 12 caratteri): ');
            if (stream_isatty(STDIN) && $readSecret('Ripeti la password: ') !== $password) {
                $out(false, ['Le due password non coincidono']);
            }
            $key = $config->kernel()->access()->consoleResetTecnico($tecnico, $password, 'console');
            $out(true, [
                'Password del Tecnico aggiornata e sessioni chiuse.',
                "Nuova Recovery Key: {$key}",
                'Conservarla offline: la precedente non è più valida.',
            ]);
            // no break
        default:
            fwrite(STDERR, "Comandi: piano, installa, disinstalla, elenco, codice-setup, recupero-tecnico\n");
            exit(2);
    }
} catch (\Throwable $e) {
    $out(false, [$e->getMessage()]);
}
