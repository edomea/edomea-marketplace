{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMP Desk",
  "version": "0.5.0-alpha.1",
  "identifier": "it.edomea.desk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EMP Desk — Edomea Marketplace",
        "width": 1000,
        "height": 760,
        "minWidth": 620,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "languages": [
          "Italian"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "resources": {
      "pacchetti/": "pacchetti/",
      "php/": "php/"
    }
  }
}
