#!/usr/bin/env bash
# EMP Server — comandi di gestione sulla console del Server (Ubuntu Server LTS).
#
#   sudo emp-server stato                          servizi, versioni, indirizzi, certificato
#   sudo emp-server indirizzi                      indirizzi https:// per le postazioni del negozio
#   sudo emp-server codice-setup                   nuovo codice monouso per il primo setup del Tecnico
#   sudo emp-server recupero-tecnico NOME          nuova password del Tecnico e nuova Recovery Key
#   sudo emp-server certificato [--se-necessario]  rigenera il certificato HTTPS (es. cambio indirizzo IP)
#   sudo emp-server backup                         backup completo di EMP (database, Core, plugin, versione)
#   sudo emp-server backup-elenco                  backup su questa macchina e sulla destinazione remota
#   sudo emp-server backup-remoto collega gdrive   copia cifrata di ogni backup su Google Drive (anche sftp)
#   sudo emp-server backup-impostazioni [--ora HH:MM] [--notturno si|no] [--conserva N] [--conserva-remoti N]
#   sudo emp-server backup-scarica --remoto NOME   copia un backup remoto (decifrato) su questa macchina
#   sudo emp-server ripristina FILE|--remoto NOME [--chiave CHIAVE]  rimette EMP com'era nel backup
#   sudo emp-server backup-chiave                  chiave dei backup (cifra quelli locali e quelli remoti)
#   sudo emp-server backup-decifra FILE USCITA [--chiave CHIAVE]  copia in chiaro di un backup cifrato
#   sudo emp-server accesso-scp NOME [--togli]     backup scaricabili e plugin caricabili via scp per NOME
#   sudo emp-server elimina-vecchio-utente         elimina l'account personale "emp" (EMP usa un utente di sistema)
#   sudo emp-server sistema verifica|aggiorna|riavvia  aggiornamenti dei pacchetti di Ubuntu (con backup prima)
#   sudo emp-server moduli                         moduli installati (Core e plugin), con quelli fermi
#   sudo emp-server plugin-disattiva NOME          ferma un plugin che blocca EMP (resta installato, dati compresi)
#   sudo emp-server plugin-riattiva NOME           lo riavvia
#   sudo emp-server avvio-sicuro [--fine]          avvia solo il Core (tutti i plugin fermi); --fine per tornare al normale
#   sudo emp-server azzera --nome NOME             total reset di un clone del master (dati, identità, nome)
#   sudo emp-server collega-github                 collega questo Server a GitHub (token da GitHub)
#
# Installato da installa.sh in /opt/emp/server, collegato in /usr/local/sbin/emp-server.
set -euo pipefail
umask 027

readonly EMP_CONF_DIR=/etc/emp
readonly EMP_CONFIG=$EMP_CONF_DIR/config.php
readonly EMP_TLS=$EMP_CONF_DIR/tls
readonly EMP_DATA=/var/lib/emp
readonly EMP_MODULES=$EMP_DATA/moduli
readonly EMP_BACKUP=$EMP_DATA/backup
readonly EMP_LOGS=/var/log/emp
readonly EMP_USER=emp
readonly EMP_HOME=/opt/emp/server
readonly RUNNER_DIR=${EMP_RUNNER_DIR:-/opt/actions-runner}   # EMP_RUNNER_DIR: solo per i test
# Impostazioni dei backup: valori predefiniti, modificabili dalla pagina Backup di /techadmin
# o con "emp-server backup-impostazioni" (file /etc/emp/backup.conf, della macchina).
BACKUP_KEEP=14
REMOTE_KEEP=30
BACKUP_TIME=02:30
BACKUP_NIGHTLY=si
readonly CERT_DAYS=825
readonly CERT_RENEW_SECONDS=$((60 * 24 * 3600))

die() { echo "ERRORE: $*" >&2; exit 1; }
info() { echo "• $*"; }

require_root() {
    [[ $EUID -eq 0 ]] || die "eseguire con sudo: sudo emp-server $*"
}

# Comando del Core (bin/emp) eseguito come utente emp, che accede a MariaDB senza password (unix_socket).
core_cli() {
    [[ -f $EMP_MODULES/emp-core/bin/emp ]] || die "Core non installato: eseguire installa.sh"
    runuser -u "$EMP_USER" -- env EMP_CONFIG="$EMP_CONFIG" php "$EMP_MODULES/emp-core/bin/emp" "$@"
}

# Primo indirizzo privato. sed legge tutto l'elenco: con "head -n1" la funzione verrebbe
# interrotta (SIGPIPE) sulle macchine con più indirizzi e, con pipefail, lo script si fermerebbe.
first_private_ipv4() { private_ipv4 | sed -n 1p; }

# Indirizzi IPv4 privati della macchina (quelli coperti dal certificato).
private_ipv4() {
    local ip
    for ip in $(hostname -I 2>/dev/null); do
        if [[ $ip =~ ^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)[0-9.]+$ ]]; then
            echo "$ip"
        fi
    done
}

host_name() { hostname -s | tr '[:upper:]' '[:lower:]'; }

# Cartelle di EMP con proprietari e permessi (usata da installa.sh e da azzera).
create_dirs() {
    install -d -m 0755 -o root -g root "$EMP_DATA" "$EMP_DATA/pubblico" /opt/emp
    # Cartella dei moduli con sticky bit: emp vi installa i plugin dalla pagina web,
    # ma non può modificare, rinominare o cancellare il Core (di proprietà di root).
    install -d -m 1775 -o root -g "$EMP_USER" "$EMP_MODULES"
    install -d -m 0755 -o root -g root "$EMP_DATA/catalogo"
    # Catalogo locale del Core: plugin caricati a mano dal Tecnico o importati da una release GitHub.
    install -d -m 0750 -o "$EMP_USER" -g "$EMP_USER" "$EMP_DATA/catalogo-locale"
    install -d -m 0700 -o "$EMP_USER" -g "$EMP_USER" "$EMP_DATA/tmp"
    # File dei plugin (dati-moduli/<id>/); la sottocartella "pubblico" di ogni plugin la serve Nginx
    # in /m-file/<id>/ (es. foto dei prodotti), il resto resta privato.
    install -d -m 0755 -o "$EMP_USER" -g "$EMP_USER" "$EMP_DATA/dati-moduli"
    # Backup e arrivi dei plugin raggiungibili via scp dagli utenti abilitati (gruppo emp-file).
    getent group "$EMP_SCP_GROUP" >/dev/null || groupadd --system "$EMP_SCP_GROUP"
    install -d -m 0750 -o root -g "$EMP_SCP_GROUP" "$EMP_BACKUP"
    find "$EMP_BACKUP" -maxdepth 1 -type f -name 'emp-backup-*.tar' -exec chgrp "$EMP_SCP_GROUP" {} + -exec chmod 0640 {} +
    install -d -m 0755 -o root -g root "$EMP_DATA/arrivi"
    # setgid: i file caricati restano del gruppo emp-file; il Core (proprietario) li legge e li elimina.
    install -d -m 2770 -o "$EMP_USER" -g "$EMP_SCP_GROUP" "$EMP_ARRIVALS"
    install -d -m 0750 -o "$EMP_USER" -g adm "$EMP_LOGS"
    install -d -m 0755 -o root -g root "$EMP_CONF_DIR"
    # Pagina Backup di /techadmin: il Core (utente emp) deposita le richieste, il servizio
    # emp-backup-web (root) le esegue e scrive lo stato; i file da scaricare li serve Nginx.
    install -d -m 0750 -o root -g "$EMP_USER" "$EMP_DATA/backup-web"
    install -d -m 0700 -o "$EMP_USER" -g "$EMP_USER" "$EMP_DATA/backup-web/preparazione" "$EMP_DATA/backup-web/richieste" "$EMP_DATA/backup-web/risposte"
    install -d -m 0700 -o root -g root "$EMP_DATA/backup-web/lavorazione"
    if getent group www-data >/dev/null; then
        install -d -m 0750 -o root -g www-data "$EMP_DATA/scaricamenti"
    fi
}

extra_dns() {
    if [[ -f $EMP_CONF_DIR/nome-dns ]]; then tr -d '[:space:]' < "$EMP_CONF_DIR/nome-dns"; fi
}

# ---------------------------------------------------------------- certificato HTTPS
#
# Autorità di certificazione locale, valida SOLO per i nomi di questo Server e per
# gli indirizzi delle reti private (name constraints): anche se la sua chiave
# venisse sottratta, non potrebbe certificare siti Internet.
create_ca() {
    local name dns
    name=$(host_name)
    dns=$(extra_dns)
    local constraints="permitted;DNS:${name},permitted;DNS:${name}.local,permitted;DNS:localhost"
    [[ -n $dns ]] && constraints+=",permitted;DNS:${dns}"
    constraints+=",permitted;IP:10.0.0.0/255.0.0.0,permitted;IP:172.16.0.0/255.240.0.0"
    constraints+=",permitted;IP:192.168.0.0/255.255.0.0,permitted;IP:127.0.0.0/255.0.0.0"
    info "Creazione dell'autorità di certificazione locale (valida 10 anni)"
    openssl req -x509 -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
        -keyout "$EMP_TLS/ca.key" -out "$EMP_TLS/ca.crt" -days 3650 \
        -subj "/O=EMP Edomea Marketplace/CN=EMP CA locale ${name}" \
        -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" \
        -addext "nameConstraints=critical,${constraints}" 2>/dev/null
    chmod 0600 "$EMP_TLS/ca.key"
    chmod 0644 "$EMP_TLS/ca.crt"
}

wanted_san() {
    local name dns ip
    name=$(host_name)
    dns=$(extra_dns)
    printf 'DNS:%s,DNS:%s.local,DNS:localhost' "$name" "$name"
    [[ -n $dns ]] && printf ',DNS:%s' "$dns"
    printf ',IP:127.0.0.1'
    for ip in $(private_ipv4); do printf ',IP:%s' "$ip"; done
}

cert_needs_renewal() {
    local crt=$EMP_TLS/server.crt ip san
    [[ -f $crt && -f $EMP_TLS/server.key ]] || return 0
    openssl x509 -in "$crt" -noout -checkend "$CERT_RENEW_SECONDS" >/dev/null 2>&1 || return 0
    san=$(openssl x509 -in "$crt" -noout -ext subjectAltName 2>/dev/null | tr -d ' \n')
    for ip in $(private_ipv4); do
        [[ ,$san, == *",IPAddress:${ip},"* ]] || return 0
    done
    [[ $san == *"DNS:$(host_name),"* ]] || return 0
    return 1
}

create_server_cert() {
    local tmp
    tmp=$(mktemp -d)
    info "Creazione del certificato HTTPS del Server (valido ${CERT_DAYS} giorni)"
    openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
        -keyout "$tmp/server.key" -out "$tmp/server.csr" -subj "/O=EMP Edomea Marketplace/CN=$(host_name)" 2>/dev/null
    cat > "$tmp/ext.cnf" <<EOF
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=serverAuth
subjectAltName=$(wanted_san)
EOF
    openssl x509 -req -in "$tmp/server.csr" -CA "$EMP_TLS/ca.crt" -CAkey "$EMP_TLS/ca.key" \
        -CAcreateserial -CAserial "$EMP_TLS/ca.srl" -days "$CERT_DAYS" -sha256 \
        -extfile "$tmp/ext.cnf" -out "$tmp/server.crt" 2>/dev/null
    cat "$tmp/server.crt" "$EMP_TLS/ca.crt" > "$tmp/fullchain.crt"
    install -m 0600 -o root -g root "$tmp/server.key" "$EMP_TLS/server.key"
    install -m 0644 -o root -g root "$tmp/fullchain.crt" "$EMP_TLS/server.crt"
    rm -rf "$tmp"
}

cmd_certificato() {
    require_root certificato
    install -d -m 0755 -o root -g root "$EMP_TLS"
    [[ -f $EMP_TLS/ca.crt && -f $EMP_TLS/ca.key ]] || create_ca
    if [[ ${1:-} == --se-necessario ]] && ! cert_needs_renewal; then
        return 0
    fi
    create_server_cert
    # Certificato dell'autorità scaricabile dalle postazioni (http://SERVER/emp-ca.crt).
    install -m 0644 -o root -g root "$EMP_TLS/ca.crt" "$EMP_DATA/pubblico/emp-ca.crt"
    if systemctl is-active --quiet nginx; then
        nginx -t -q && systemctl reload nginx
    fi
    info "Certificato valido per: $(wanted_san | tr ',' ' ')"
}

ca_fingerprint() {
    openssl x509 -in "$EMP_TLS/ca.crt" -noout -fingerprint -sha256 | cut -d= -f2
}

# ---------------------------------------------------------------- comandi

cmd_indirizzi() {
    local ip any=0
    for ip in $(private_ipv4); do
        echo "  https://${ip}/admin/       Amministratore Operativo e utenti"
        echo "  https://${ip}/techadmin/   Amministratore Tecnico"
        any=1
    done
    echo "  https://$(host_name).local/admin/ e /techadmin/   (se la rete risolve i nomi .local)"
    [[ -n $(extra_dns) ]] && echo "  https://$(extra_dns)/admin/ e /techadmin/"
    [[ $any -eq 1 ]] || echo "  (nessun indirizzo di rete privata: controllare la scheda di rete della VM, modalità Bridged)"
}

# Per il Control Center di /techadmin: servizi, certificato, disco, memoria, avvio della macchina.
server_status_tsv() {
    local svc state
    for svc in nginx "php$(php_version)-fpm" mariadb emp-backup.timer; do
        state=$(systemctl is-active "$svc" 2>/dev/null || true)
        printf 'servizio\t%s\t%s\n' "$svc" "${state:-sconosciuto}"
    done
    if [[ -f $EMP_TLS/server.crt ]]; then
        printf 'certificato_scade\t%s\n' "$(date -d "$(openssl x509 -in "$EMP_TLS/server.crt" -noout -enddate | cut -d= -f2)" +%s 2>/dev/null || echo 0)"
    fi
    { df -B1 --output=avail,size "$EMP_DATA" 2>/dev/null || true; } | awk 'NR==2 {printf "disco\t%s\t%s\n", $1, $2}'
    awk '/^MemAvailable:/ {a=$2} /^MemTotal:/ {t=$2} END {printf "memoria\t%d\t%d\n", a*1024, t*1024}' /proc/meminfo || true
    printf 'avviato\t%s\n' "$(($(date +%s) - $(cut -d. -f1 /proc/uptime)))"
    printf 'nome\t%s\n' "$(host_name)"
    printf 'indirizzo\t%s\n' "$(first_private_ipv4)"
    return 0
}

cmd_stato() {
    require_root stato
    if [[ ${1:-} == --tsv ]]; then server_status_tsv; return 0; fi
    local svc state
    echo "EMP Server $(cat "$EMP_HOME/VERSIONE" 2>/dev/null || echo '?') — $(lsb_release -ds 2>/dev/null || true)"
    for svc in nginx "php$(php_version)-fpm" mariadb; do
        state=$(systemctl is-active "$svc" 2>/dev/null || true)
        printf '  %-14s %s\n' "$svc" "${state:-sconosciuto}"
    done
    if curl -fsS --max-time 5 --cacert "$EMP_TLS/ca.crt" --resolve "localhost:443:127.0.0.1" https://localhost/api/v1/salute >/dev/null 2>&1; then
        echo "  Core           risponde"
    else
        echo "  Core           NON risponde (vedere: journalctl -u nginx, /var/log/nginx/emp-errori.log)"
    fi
    echo "Moduli:"
    core_cli elenco | sed 's/^/  /' || true
    boot_status_lines
    echo "Certificato HTTPS: scade il $(openssl x509 -in "$EMP_TLS/server.crt" -noout -enddate | cut -d= -f2)"
    echo "Impronta SHA-256 dell'autorità locale: $(ca_fingerprint)"
    local last
    last=$(find "$EMP_BACKUP" -maxdepth 1 -type f -name 'emp-backup-*.tar' -printf '%T@ %f\n' 2>/dev/null | sort -rn | sed -n '1s/^[^ ]* //p')
    echo "Ultimo backup: ${last:-nessuno}"
    warn_personal_emp_user
    # Account Google abbreviato: "stato" finisce anche nei log pubblici delle installazioni da GitHub.
    if [[ -f $REMOTE_CONF ]]; then echo "Copia remota: $(remote_description)$([[ -f $REMOTE_DIR/account ]] && echo " — account $(sed -E 's/^(.{2})[^@]*@/\1…@/' "$REMOTE_DIR/account")")"; else echo "Copia remota: non collegata (sudo emp-server backup-remoto collega gdrive)"; fi
    echo "Indirizzi:"
    cmd_indirizzi
}

php_version() { php -r 'echo PHP_MAJOR_VERSION, ".", PHP_MINOR_VERSION;'; }

cmd_codice_setup() {
    require_root codice-setup
    core_cli codice-setup
    echo "Inserirlo nella pagina di primo setup:"
    local ip
    for ip in $(private_ipv4); do echo "  https://${ip}/techadmin/setup.html"; done
}

cmd_recupero_tecnico() {
    require_root recupero-tecnico
    [[ -n ${1:-} ]] || die "uso: sudo emp-server recupero-tecnico NOME_UTENTE_DEL_TECNICO"
    core_cli recupero-tecnico "--tecnico=$1"
}

# ---------------------------------------------------------------- aggiornamenti di Ubuntu
#
# Verifica e installazione degli aggiornamenti dei pacchetti di Ubuntu (stessa versione di
# Ubuntu: mai il passaggio a una versione nuova, es. 24.04 → 26.04). Gli aggiornamenti di
# sicurezza restano installati anche ogni notte da unattended-upgrades.
# Usati anche dalla pagina Sistema di /techadmin (servizio emp-backup-web).

readonly SYSTEM_DIR=$EMP_DATA/sistema
readonly SYSTEM_CACHE=$SYSTEM_DIR/aggiornamenti.tsv

apt_env() { env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a NEEDRESTART_SUSPEND=1 "$@"; }

system_check() {
    install -d -m 0755 -o root -g root "$SYSTEM_DIR"
    apt_env apt-get -q -o DPkg::Lock::Timeout=600 update 2>&1 | sed 's/^/  /' || die "elenco dei pacchetti non aggiornato (Internet?)"
    local tmp
    tmp=$(mktemp "$SYSTEM_DIR/.aggiornamenti-XXXXXX")
    # Simulazione: nessuna modifica. Righe "Inst pacchetto [vecchia] (nuova origine [arch])".
    LC_ALL=C apt-get -s -o Debug::NoLocking=1 --with-new-pkgs upgrade 2>/dev/null \
        | sed -nE 's/^Inst ([^ ]+) (\[([^]]+)\] )?\(([^ ]+) ([^)]*)\).*/\1\t\3\t\4\t\5/p' \
        | awk -F'\t' 'BEGIN{OFS="\t"} {print $1, ($2==""?"-":$2), $3, ($4 ~ /-security/ ? 1 : 0)}' > "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$SYSTEM_CACHE"
}

system_status_tsv() {
    local pretty total=0 security=0 checked=0 reboot=0 auto=0
    # shellcheck disable=SC1091
    pretty=$(. /etc/os-release && echo "$PRETTY_NAME")
    if [[ -f $SYSTEM_CACHE ]]; then
        total=$(wc -l < "$SYSTEM_CACHE")
        security=$(awk -F'\t' '$4==1' "$SYSTEM_CACHE" | wc -l)
        checked=$(stat -c %Y "$SYSTEM_CACHE")
    fi
    [[ -f /var/run/reboot-required ]] && reboot=1
    systemctl is-enabled --quiet unattended-upgrades 2>/dev/null && auto=1
    printf 'ubuntu\t%s\nkernel\t%s\nverificato\t%s\ndisponibili\t%s\nsicurezza\t%s\nriavvio\t%s\nautomatici\t%s\n' \
        "$pretty" "$(uname -r)" "$checked" "$total" "$security" "$reboot" "$auto"
    if [[ $reboot == 1 && -f /var/run/reboot-required.pkgs ]]; then
        printf 'riavvio_per\t%s\n' "$(sort -u /var/run/reboot-required.pkgs | tr '\n' ' ' | sed 's/ $//')"
    fi
    if [[ -f $SYSTEM_CACHE ]]; then sed 's/^/pacchetto\t/' "$SYSTEM_CACHE"; fi
}

cmd_sistema() {
    require_root sistema
    local action=${1:-stato}
    shift || true
    case $action in
        verifica)
            info "Verifica degli aggiornamenti di Ubuntu"
            system_check
            local n s
            n=$(wc -l < "$SYSTEM_CACHE"); s=$(awk -F'\t' '$4==1' "$SYSTEM_CACHE" | wc -l)
            info "Aggiornamenti disponibili: $n (di sicurezza: $s)"
            [[ $n -gt 0 ]] && awk -F'\t' '{printf "  %-40s %s → %s%s\n", $1, $2, $3, ($4==1 ? "  [sicurezza]" : "")}' "$SYSTEM_CACHE"
            return 0 ;;
        aggiorna)
            info "Backup di EMP prima degli aggiornamenti di Ubuntu"
            local rc=0
            cmd_backup --etichetta prima-di-aggiornamenti-ubuntu || rc=$?
            ((rc == 0 || rc == 3)) || die "backup non riuscito: aggiornamenti di Ubuntu NON installati"
            info "Installazione degli aggiornamenti di Ubuntu (i servizi interessati si riavviano da soli)"
            # NEEDRESTART_SUSPEND (in apt_env): needrestart non riavvia servizi a metà installazione,
            # nemmeno quello della pagina Sistema che la sta eseguendo; i pacchetti riavviano i propri.
            if ! apt_env apt-get -q -y -o DPkg::Lock::Timeout=900 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
                --with-new-pkgs upgrade 2>&1 | sed 's/^/  /'; then
                die "installazione degli aggiornamenti non riuscita (vedere il dettaglio sopra)"
            fi
            system_check >/dev/null
            health_ok || die "dopo gli aggiornamenti EMP non risponde: controllare $EMP_LOGS (backup: prima-di-aggiornamenti-ubuntu)"
            info "Aggiornamenti installati. EMP risponde."
            if [[ -f /var/run/reboot-required ]]; then
                info "Serve un RIAVVIO del server per completarli (es. nuovo kernel): sudo emp-server sistema riavvia"
            fi ;;
        riavvia)
            info "Il server si riavvia tra 1 minuto. EMP torna disponibile da solo dopo l'avvio."
            shutdown -r +1 "Riavvio richiesto per gli aggiornamenti di Ubuntu (EMP)" >/dev/null 2>&1 || die "riavvio non programmato" ;;
        stato)
            if [[ ${1:-} == --tsv ]]; then system_status_tsv; return 0; fi
            local key value
            while IFS=$'\t' read -r key value _; do
                case $key in
                    ubuntu) echo "Sistema: $value" ;;
                    kernel) echo "Kernel: $value" ;;
                    verificato) if [[ $value == 0 ]]; then echo "Ultima verifica: mai (sudo emp-server sistema verifica)"; else echo "Ultima verifica: $(date -d "@$value" '+%d/%m/%Y %H:%M')"; fi ;;
                    disponibili) echo "Aggiornamenti disponibili: $value" ;;
                    sicurezza) echo "  di sicurezza: $value" ;;
                    riavvio) if [[ $value == 1 ]]; then echo "Riavvio necessario: sì (sudo emp-server sistema riavvia)"; else echo "Riavvio necessario: no"; fi ;;
                    automatici) if [[ $value == 1 ]]; then echo "Aggiornamenti di sicurezza automatici: attivi (ogni notte)"; else echo "Aggiornamenti di sicurezza automatici: NON attivi"; fi ;;
                esac
            done < <(system_status_tsv) ;;
        *) die "uso: sudo emp-server sistema stato | verifica | aggiorna | riavvia" ;;
    esac
}

# ---------------------------------------------------------------- utenti, accesso scp, arrivi

readonly EMP_SCP_GROUP=emp-file
readonly EMP_ARRIVALS=$EMP_DATA/arrivi/plugin

# Un account "personale" (creato con l'installazione di Ubuntu o con adduser) ha UID da 1000 in su.
# L'utente di EMP deve essere di sistema: niente accesso SSH, niente sudo, niente home.
emp_user_is_personal() {
    local uid min
    uid=$(id -u "$EMP_USER" 2>/dev/null) || return 1
    min=$(awk '/^UID_MIN/ {print $2}' /etc/login.defs 2>/dev/null)
    ((uid >= ${min:-1000} && uid != 65534))
}

warn_personal_emp_user() {
    emp_user_is_personal || return 0
    echo
    echo "ATTENZIONE: l'utente '$EMP_USER' è un account personale (accesso SSH, sudo): EMP gira con i suoi permessi."
    echo "  1. crea il tuo utente:     sudo adduser NOME && sudo usermod -aG sudo NOME"
    echo "  2. rientra con quello:     ssh NOME@$(first_private_ipv4)"
    echo "  3. elimina il vecchio:     sudo emp-server elimina-vecchio-utente"
    echo
}

cmd_elimina_vecchio_utente() {
    require_root elimina-vecchio-utente
    local yes=0
    [[ ${1:-} == --si ]] && yes=1
    if ! emp_user_is_personal; then
        info "L'utente '$EMP_USER' è già un utente di sistema: niente da fare"
        return 0
    fi
    local admin=${SUDO_USER:-}
    [[ -n $admin && $admin != root && $admin != "$EMP_USER" ]] \
        || die "eseguire con sudo da un ALTRO utente amministratore (es. ssh NOME@server, poi sudo emp-server elimina-vecchio-utente)"
    # Sessioni ancora aperte del vecchio account (escluso PHP-FPM, che viene fermato qui).
    local others
    others=$(pgrep -u "$EMP_USER" -l 2>/dev/null | awk '$2 !~ /^php-fpm/ {print $2}' | sort -u | tr '\n' ' ' || true)
    [[ -z ${others// /} ]] || die "l'utente '$EMP_USER' ha ancora processi aperti ($others): chiudere le sue sessioni SSH e riprovare"
    local home
    home=$(getent passwd "$EMP_USER" | cut -d: -f6)
    echo "Verrà ELIMINATO l'account personale '$EMP_USER' (UID $(id -u "$EMP_USER")) con la sua cartella ${home:-?}."
    echo "Al suo posto EMP avrà un utente di sistema '$EMP_USER': niente accesso SSH, niente sudo."
    echo "Amministratore che resta: $admin. Dati, database e plugin di EMP non vengono toccati."
    if ((!yes)); then
        local answer
        read -r -p "Scrivi ELIMINA per continuare: " answer
        [[ $answer == ELIMINA ]] || die "annullato: nessuna modifica"
    fi

    local old_uid old_gid fpm
    old_uid=$(id -u "$EMP_USER")
    old_gid=$(id -g "$EMP_USER")
    fpm="php$(php_version)-fpm"
    systemctl stop "$fpm"
    pkill -u "$EMP_USER" 2>/dev/null || true
    sleep 1
    userdel -r "$EMP_USER" 2>/dev/null || userdel "$EMP_USER"
    rm -f "/etc/sudoers.d/$EMP_USER"
    getent group "$EMP_USER" >/dev/null || groupadd --system "$EMP_USER"
    useradd --system -g "$EMP_USER" --home-dir "$EMP_DATA" --no-create-home --shell /usr/sbin/nologin "$EMP_USER"
    # I file del vecchio account (dati di EMP, registri, sessioni) passano al nuovo utente di sistema.
    find / -xdev \( -path /proc -o -path /sys -o -path /dev \) -prune -o -uid "$old_uid" -exec chown -h "$EMP_USER" {} + 2>/dev/null || true
    find / -xdev \( -path /proc -o -path /sys -o -path /dev \) -prune -o -gid "$old_gid" -exec chgrp -h "$EMP_USER" {} + 2>/dev/null || true
    create_dirs
    systemctl start "$fpm"
    health_ok || die "il Core non risponde dopo il cambio di utente: controllare $EMP_LOGS"
    info "Vecchio account eliminato. '$EMP_USER' è ora un utente di sistema (UID $(id -u "$EMP_USER"))."
    info "Per scaricare i backup e caricare i plugin via scp: sudo emp-server accesso-scp $admin"
}

cmd_accesso_scp() {
    require_root accesso-scp
    local name=${1:-} remove=0
    [[ ${2:-} == --togli ]] && remove=1
    [[ -n $name ]] || die "uso: sudo emp-server accesso-scp NOMEUTENTE [--togli]"
    id -u "$name" >/dev/null 2>&1 || die "utente '$name' inesistente"
    [[ $name != "$EMP_USER" && $name != root ]] || die "'$name' non può avere l'accesso scp"
    getent group "$EMP_SCP_GROUP" >/dev/null || groupadd --system "$EMP_SCP_GROUP"
    if ((remove)); then
        gpasswd -d "$name" "$EMP_SCP_GROUP" >/dev/null 2>&1 || true
        info "Accesso scp tolto a $name"
        return 0
    fi
    usermod -aG "$EMP_SCP_GROUP" "$name"
    local ip
    ip=$(first_private_ipv4)
    info "Accesso scp dato a $name (vale dal prossimo accesso SSH di $name)"
    echo "  Scaricare un backup, dal PC:   scp $name@$ip:$EMP_BACKUP/emp-backup-….tar .   (cifrato: serve la chiave dei backup)"
    echo "  Caricare un plugin, dal PC:    scp mio-plugin.zip $name@$ip:$EMP_ARRIVALS/"
    echo "  I plugin caricati compaiono nella pagina Plugin del Tecnico (https://$ip/techadmin/plugin.html)."
}

# ---------------------------------------------------------------- backup e ripristino di EMP
#
# Il backup riguarda TUTTO EMP e solo EMP: database, Core e plugin installati, cataloghi
# dei plugin e il pacchetto della versione di EMP Server in uso (per rimettere la stessa
# versione). Non contiene ciò che appartiene alla macchina: Ubuntu, nome host, chiavi SSH,
# certificato HTTPS e sua autorità, collegamento a GitHub, destinazione dei backup remoti.
# Un ripristino su una macchina nuova ne conserva quindi l'identità, come una nuova installazione.
#
# File: /var/lib/emp/backup/emp-backup-<server>-<AAAAMMGG-HHMMSS>[-etichetta].tar
#   MANIFEST  SHA256SUMS  database.sql.gz  dati.tar.gz  [emp-server-<versione>.tar.gz]
# Dalla 0.6.0-alpha.11 il file su questa macchina è CIFRATO con la chiave dei backup
# (/etc/emp/backup-chiave, della macchina: AES-256-CBC, PBKDF2, formato di "openssl enc", inizia
# con "Salted__"). Chi lo scarica via scp senza la chiave non legge nulla. I file precedenti, in
# chiaro, vengono cifrati al primo backup. Ripristino e "backup-decifra" lo rimettono in chiaro.
# Se è collegata una destinazione remota (emp-server backup-remoto), ogni backup viene
# copiato anche lì, cifrato di nuovo con la stessa chiave (rclone crypt).

readonly BACKUP_FORMAT=1
# Tra i dati (non in $EMP_HOME): resta anche dopo disinstalla.sh, così il backup automatico
# di una reinstallazione conosce ancora la versione in uso e ne include il pacchetto.
readonly EMP_PACKAGE_DIR=$EMP_DATA/pacchetto
readonly REMOTE_DIR=$EMP_CONF_DIR/backup-remoto
readonly REMOTE_CONF=$REMOTE_DIR/rclone.conf
# dati-moduli: file dei plugin (es. foto dei prodotti di EMP Studio), dalla 0.6.0-alpha.22.
readonly EMP_DATA_DIRS="moduli catalogo catalogo-locale dati-moduli"

# Cartelle temporanee rimosse all'uscita (niente trap RETURN: in Bash sono globali e si
# sovrappongono quando una funzione ne chiama un'altra, es. il backup dentro il ripristino).
EMP_TEMP_DIRS=()
emp_cleanup() { local d; for d in "${EMP_TEMP_DIRS[@]}"; do rm -rf -- "$d"; done; }
trap emp_cleanup EXIT
new_temp_dir() { # $1 = variabile, $2 = cartella padre
    local -n _out=$1
    _out=$(mktemp -d "$2/.$1-XXXXXX")
    EMP_TEMP_DIRS+=("$_out")
}

# ---------------------------------------------------------------- chiave dei backup (una per macchina)
#
# Una sola chiave per tutti i backup di questa macchina, locali e remoti: è la stessa della
# destinazione remota (Google Drive, SFTP, cartella). Sui Server collegati prima della
# 0.6.0-alpha.11 si riprende quella già usata per la destinazione remota.

readonly BACKUP_KEY_FILE=$EMP_CONF_DIR/backup-chiave
readonly BACKUP_CIPHER=(-aes-256-cbc -pbkdf2 -iter 200000 -md sha256)

valid_backup_key() { [[ $1 =~ ^EMP-BK(-[A-Z2-7]{6}){5}$ ]]; }

save_backup_key() {
    local tmp
    install -d -m 0755 -o root -g root "$EMP_CONF_DIR"
    tmp=$(mktemp "$EMP_CONF_DIR/.backup-chiave-XXXXXX")
    chmod 0600 "$tmp"
    printf '%s\n' "$1" > "$tmp"
    mv "$tmp" "$BACKUP_KEY_FILE"
}

# Stampa la chiave della macchina; se manca la riprende dalla destinazione remota o ne crea una nuova.
backup_key() {
    local key=''
    if [[ -f $BACKUP_KEY_FILE ]]; then
        key=$(head -n1 "$BACKUP_KEY_FILE")
        if valid_backup_key "$key"; then echo "$key"; return 0; fi
        key=''
    fi
    if [[ -f $REMOTE_CONF ]] && command -v rclone >/dev/null; then
        key=$(rclone reveal "$(sed -n 's/^password = //p' "$REMOTE_CONF" | head -n1)" 2>/dev/null || true)
        valid_backup_key "$key" || key=''
    fi
    [[ -n $key ]] || key=$(new_backup_key)
    save_backup_key "$key"
    echo "$key"
}

is_encrypted_backup() { [[ $(head -c 8 "$1" 2>/dev/null) == Salted__ ]]; }

# La chiave arriva a openssl dallo standard input, mai sulla riga di comando (visibile con ps).
encrypt_backup_file() { # $1 file in chiaro, $2 file cifrato, $3 chiave
    printf '%s\n' "$3" | openssl enc -e "${BACKUP_CIPHER[@]}" -salt -pass stdin -in "$1" -out "$2"
}
decrypt_backup_file() { # $1 file cifrato, $2 file in chiaro, $3 chiave
    printf '%s\n' "$3" | openssl enc -d "${BACKUP_CIPHER[@]}" -pass stdin -in "$1" -out "$2" 2>/dev/null \
        && tar -tf "$2" MANIFEST >/dev/null 2>&1
}

# Permessi dei backup locali: leggibili via scp dagli utenti abilitati (gruppo emp-file), sono cifrati.
backup_file_perms() {
    chgrp "$EMP_SCP_GROUP" "$1" 2>/dev/null || true
    chmod 0640 "$1"
}

# Sostituisce $1 con $2 conservando la data di $1 (serve all'ordine e alla conservazione degli ultimi N).
replace_keeping_date() {
    touch -r "$1" "$2"
    backup_file_perms "$2"
    mv -f -- "$2" "$1"
}

# Cifra i backup locali ancora in chiaro (creati prima della 0.6.0-alpha.11 o copiati a mano).
encrypt_local_backups() {
    local key f n=0
    [[ -d $EMP_BACKUP ]] || return 0
    key=$(backup_key)
    while IFS= read -r -d '' f; do
        is_encrypted_backup "$f" && continue
        if encrypt_backup_file "$f" "$f.cifra" "$key"; then
            replace_keeping_date "$f" "$f.cifra"
            n=$((n + 1))
        else
            rm -f -- "${f:?}.cifra"
            echo "Avviso: $(basename "$f") non cifrato"
        fi
    done < <(find "$EMP_BACKUP" -maxdepth 1 -type f -name 'emp-backup-*.tar' -print0)
    ((n == 0)) || info "Backup locali in chiaro cifrati con la chiave dei backup: $n"
}

# Nuova chiave per la macchina (es. chiave di un server precedente): i backup locali cifrati con
# la vecchia vengono ricifrati con la nuova, così si aprono tutti con la stessa chiave.
change_backup_key() {
    local new=$1 old f tmp n=0
    old=$(backup_key)
    [[ $old == "$new" ]] && return 0
    if [[ -d $EMP_BACKUP ]]; then
        while IFS= read -r -d '' f; do
            is_encrypted_backup "$f" || continue
            tmp=$(mktemp "$EMP_BACKUP/.ricifra-XXXXXX")
            if decrypt_backup_file "$f" "$tmp" "$old" && encrypt_backup_file "$tmp" "$f.cifra" "$new"; then
                replace_keeping_date "$f" "$f.cifra"
                n=$((n + 1))
            else
                rm -f -- "${f:?}.cifra"
                echo "Avviso: $(basename "$f") non si apre con la chiave attuale: lasciato com'è"
            fi
            rm -f -- "${tmp:?}"
        done < <(find "$EMP_BACKUP" -maxdepth 1 -type f -name 'emp-backup-*.tar' -print0)
    fi
    save_backup_key "$new"
    ((n == 0)) || info "Backup locali ricifrati con la nuova chiave: $n"
}

cmd_backup_chiave() {
    require_root backup-chiave
    echo "Chiave dei backup (cifra i backup su questa macchina e quelli remoti; serve per ripristinare altrove):"
    echo "  $(backup_key)"
}

cmd_backup_decifra() {
    require_root backup-decifra
    local in='' out='' key=''
    while (($#)); do
        case $1 in
            --chiave) [[ $# -ge 2 ]] || die "manca la chiave dopo --chiave"; key=$2; shift 2 ;;
            -*) die "opzione sconosciuta: $1" ;;
            *) if [[ -z $in ]]; then in=$1; else out=$1; fi; shift ;;
        esac
    done
    [[ -n $in && -n $out && -f $in ]] || die "uso: sudo emp-server backup-decifra FILE USCITA [--chiave CHIAVE]"
    [[ ! -e $out ]] || die "$out esiste già"
    [[ -n $key ]] || key=$(backup_key)
    valid_backup_key "$key" || die "chiave dei backup non valida (formato EMP-BK-XXXXXX-…)"
    if ! is_encrypted_backup "$in"; then
        cp -- "$in" "$out"
        info "$in non è cifrato: copiato com'è in $out"
        return 0
    fi
    if ! ( umask 077; decrypt_backup_file "$in" "$out" "$key" ); then
        rm -f -- "${out:?}"
        die "chiave sbagliata per questo backup (o file danneggiato)"
    fi
    info "Backup in chiaro: $out (contiene tutti i dati di EMP: conservarlo con cura)"
}

installed_server_version() {
    if [[ -f $EMP_HOME/VERSIONE ]]; then
        tr -d '[:space:]' < "$EMP_HOME/VERSIONE"
    else # programmi tolti (disinstalla.sh): la versione è quella del pacchetto conservato
        find "$EMP_PACKAGE_DIR" -maxdepth 1 -name 'emp-server-*.tar.gz' -printf '%f\n' 2>/dev/null | sed -n '1s/^emp-server-\(.*\)\.tar\.gz$/\1/p'
    fi
}
installed_core_version() {
    # shellcheck disable=SC2016  # codice PHP, non variabili della shell
    [[ -f $EMP_MODULES/emp-core/emp-module.json ]] && php -r 'echo json_decode(file_get_contents($argv[1]), true)["version"] ?? "";' "$EMP_MODULES/emp-core/emp-module.json"
}
emp_database_exists() { [[ -n $(mariadb -N -e "SHOW DATABASES LIKE 'emp'" 2>/dev/null) ]]; }

rclone_emp() { rclone --config "$REMOTE_CONF" "$@"; }
remote_configured() { [[ -f $REMOTE_CONF ]] && command -v rclone >/dev/null; }

# ---------------------------------------------------------------- impostazioni dei backup
#
# /etc/emp/backup.conf (della macchina, non va nei backup): righe CHIAVE=valore, lette senza
# eseguirle. L'orario del backup notturno è applicato al timer con un file aggiuntivo di systemd.

readonly BACKUP_CONF=$EMP_CONF_DIR/backup.conf
readonly BACKUP_TIMER_DROPIN_DIR=/etc/systemd/system/emp-backup.timer.d
readonly BACKUP_TIMER_DROPIN=$BACKUP_TIMER_DROPIN_DIR/emp-impostazioni.conf

valid_backup_time() { [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }
valid_keep() { [[ $1 =~ ^[1-9][0-9]{0,2}$ ]] && (($1 <= $2)); }

load_backup_settings() {
    [[ -f $BACKUP_CONF ]] || return 0
    local key value
    while IFS='=' read -r key value; do
        case $key in
            ORA) valid_backup_time "$value" && BACKUP_TIME=$value ;;
            NOTTURNO) [[ $value == si || $value == no ]] && BACKUP_NIGHTLY=$value ;;
            CONSERVA_LOCALI) valid_keep "$value" 90 && BACKUP_KEEP=$value ;;
            CONSERVA_REMOTI) valid_keep "$value" 365 && REMOTE_KEEP=$value ;;
        esac
    done < "$BACKUP_CONF"
    return 0
}

save_backup_settings() {
    local tmp
    tmp=$(mktemp "$EMP_CONF_DIR/.backup-XXXXXX")
    {
        echo "# EMP Server — impostazioni dei backup (pagina Backup di /techadmin o emp-server backup-impostazioni)"
        echo "ORA=$BACKUP_TIME"
        echo "NOTTURNO=$BACKUP_NIGHTLY"
        echo "CONSERVA_LOCALI=$BACKUP_KEEP"
        echo "CONSERVA_REMOTI=$REMOTE_KEEP"
    } > "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$BACKUP_CONF"
}

# Orario e attivazione del backup notturno (usata anche da installa.sh e dal ripristino).
apply_backup_timer() {
    load_backup_settings
    command -v systemctl >/dev/null || return 0
    install -d -m 0755 "$BACKUP_TIMER_DROPIN_DIR"
    printf '# Generato da emp-server backup-impostazioni\n[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00\n' "$BACKUP_TIME" > "$BACKUP_TIMER_DROPIN"
    systemctl daemon-reload 2>/dev/null || true
    if [[ $BACKUP_NIGHTLY == si ]]; then
        systemctl enable -q emp-backup.timer 2>/dev/null || true
        systemctl restart emp-backup.timer 2>/dev/null || true
    else
        systemctl disable -q --now emp-backup.timer 2>/dev/null || true
    fi
}

next_backup_epoch() {
    [[ $BACKUP_NIGHTLY == si ]] || return 0
    systemctl show emp-backup.timer -p NextElapseUSecRealtime --value --timestamp=unix 2>/dev/null | tr -d '@' | grep -E '^[0-9]+$' || true
}

cmd_backup_impostazioni() {
    require_root backup-impostazioni
    load_backup_settings
    local tsv=0 changed=0
    while (($#)); do
        case $1 in
            --ora) valid_backup_time "${2:-}" || die "orario non valido (HH:MM, es. 02:30)"; BACKUP_TIME=$2; changed=1; shift 2 ;;
            --notturno) [[ $# -ge 2 && ( $2 == si || $2 == no ) ]] || die "uso: --notturno si|no"; BACKUP_NIGHTLY=$2; changed=1; shift 2 ;;
            --conserva) valid_keep "${2:-}" 90 || die "backup locali da conservare: da 1 a 90"; BACKUP_KEEP=$2; changed=1; shift 2 ;;
            --conserva-remoti) valid_keep "${2:-}" 365 || die "backup remoti da conservare: da 1 a 365"; REMOTE_KEEP=$2; changed=1; shift 2 ;;
            --tsv) tsv=1; shift ;;
            *) die "opzione sconosciuta: $1" ;;
        esac
    done
    if ((changed)); then
        save_backup_settings
        apply_backup_timer
        info "Impostazioni dei backup salvate"
    fi
    if ((tsv)); then
        printf 'ora\t%s\nnotturno\t%s\nconserva_locali\t%s\nconserva_remoti\t%s\nprossimo\t%s\n' \
            "$BACKUP_TIME" "$BACKUP_NIGHTLY" "$BACKUP_KEEP" "$REMOTE_KEEP" "$(next_backup_epoch)"
    else
        echo "Backup notturno: $([[ $BACKUP_NIGHTLY == si ]] && echo "attivo, ogni notte alle $BACKUP_TIME" || echo disattivato)"
        echo "Backup conservati: ultimi $BACKUP_KEEP su questa macchina, ultimi $REMOTE_KEEP sulla destinazione remota"
    fi
}

cmd_backup() {
    require_root backup
    load_backup_settings
    local label='' upload=1
    while (($#)); do
        case $1 in
            --etichetta) [[ $# -ge 2 && $2 =~ ^[a-z0-9][a-z0-9.-]{0,40}$ ]] || die "etichetta non valida"; label=$2; shift 2 ;;
            --solo-locale) upload=0; shift ;;
            *) die "opzione sconosciuta: $1" ;;
        esac
    done
    emp_database_exists || die "database emp assente: niente da salvare"
    [[ -f $EMP_MODULES/emp-core/emp-module.json ]] || die "Core non installato: niente da salvare"

    local server core stamp name work file
    server=$(installed_server_version)
    core=$(installed_core_version)
    stamp=$(date +%Y%m%d-%H%M%S)
    name="emp-backup-$(host_name)-${stamp}${label:+-$label}"
    new_temp_dir work "$EMP_BACKUP"

    mariadb-dump --single-transaction --routines --events --triggers --hex-blob \
        --default-character-set=utf8mb4 emp | gzip -6 > "$work/database.sql.gz"
    gzip -t "$work/database.sql.gz" || die "esportazione del database non riuscita"
    # Solo le cartelle che ci sono (es. dati-moduli prima del primo avvio della 0.6.0-alpha.22).
    local present=() d
    # shellcheck disable=SC2086  # elenco fisso di cartelle
    for d in $EMP_DATA_DIRS; do [[ -d $EMP_DATA/$d ]] && present+=("$d"); done
    tar -C "$EMP_DATA" -czf "$work/dati.tar.gz" "${present[@]}"
    local package="emp-server-${server}.tar.gz"
    if [[ -f $EMP_PACKAGE_DIR/$package ]]; then
        cp "$EMP_PACKAGE_DIR/$package" "$work/$package"
    else
        package=''
        echo "Avviso: pacchetto di EMP Server ${server:-?} non conservato sul Server (installato prima della 0.6.0-alpha.6):"
        echo "        il ripristino di questo backup richiederà EMP Server ${server:-?} già installato."
    fi
    {
        echo "formato=$BACKUP_FORMAT"
        echo "emp_server=$server"
        echo "core=$core"
        echo "creato=$(date -Iseconds)"
        echo "macchina=$(host_name)"
        echo "etichetta=$label"
        echo "pacchetto=$package"
    } > "$work/MANIFEST"
    ( cd "$work" && sha256sum MANIFEST database.sql.gz dati.tar.gz ${package:+"$package"} > SHA256SUMS )
    file="$EMP_BACKUP/$name.tar"
    tar -C "$work" -cf "$work/backup.tar" MANIFEST SHA256SUMS database.sql.gz dati.tar.gz ${package:+"$package"}
    if ! encrypt_backup_file "$work/backup.tar" "$file.parziale" "$(backup_key)"; then
        rm -f -- "${file:?}.parziale"
        die "cifratura del backup non riuscita"
    fi
    backup_file_perms "$file.parziale"
    mv "$file.parziale" "$file"
    rm -rf "$work"
    info "Backup di EMP (Server ${server}, Core ${core}), cifrato: $file ($(du -h "$file" | cut -f1))"
    encrypt_local_backups

    # Conserva solo gli ultimi BACKUP_KEEP (anche le cartelle del vecchio formato).
    find "$EMP_BACKUP" -maxdepth 1 -type f -name 'emp-backup-*.tar' -printf '%T@ %p\n' | sort -rn \
        | tail -n +$((BACKUP_KEEP + 1)) | cut -d' ' -f2- | xargs -r rm -f --
    find "$EMP_BACKUP" -mindepth 1 -maxdepth 1 -type d -name 'emp-2*' -exec rm -rf -- {} +

    if ((upload)) && remote_configured; then
        if rclone_emp copyto "$file" "emp-cifrato:$name.tar" 2>&1 | sed 's/^/  /'; then
            info "Copia cifrata inviata a $(remote_description)"
            # Conservazione remota: ultimi REMOTE_KEEP backup di QUESTO server (gli altri non si toccano).
            rclone_emp lsf emp-cifrato: --files-only 2>/dev/null | grep "^emp-backup-$(host_name)-[0-9].*\.tar\$" | sort | head -n -"$REMOTE_KEEP" \
                | while read -r old; do rclone_emp deletefile "emp-cifrato:$old" || true; done
        else
            echo "Avviso: copia remota non riuscita (Internet o destinazione non raggiungibile): il backup locale è valido."
            return 3
        fi
    elif ((upload)); then
        echo "Avviso: nessuna destinazione remota collegata: il backup resta solo su questa macchina (sudo emp-server backup-remoto collega gdrive)."
    fi
}

cmd_backup_elenco() {
    require_root backup-elenco
    if [[ ${1:-} == --tsv ]]; then
        # Per la pagina Backup: origine, nome, byte, data (secondi dal 1970), cifrato (1/0), dal più recente.
        local kind name size mtime
        find "$EMP_BACKUP" -maxdepth 1 -type f -name 'emp-backup-*.tar' -printf 'locale\t%f\t%s\t%T@\n' 2>/dev/null | sort -t$'\t' -k4,4nr \
            | while IFS=$'\t' read -r kind name size mtime; do
                printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$name" "$size" "$mtime" "$(is_encrypted_backup "$EMP_BACKUP/$name" && echo 1 || echo 0)"
            done
        if remote_configured; then
            local list
            if list=$(rclone_emp lsjson emp-cifrato: --files-only 2>/dev/null); then
                # Collegamenti precedenti alla 0.6.0-alpha.10: l'account si legge ora (rclone ha appena rinnovato il token).
                [[ -f $REMOTE_DIR/account ]] || gdrive_save_account || true
                printf 'destinazione\t%s\t1\n' "$(remote_description)"
                # shellcheck disable=SC2016  # codice PHP, non variabili della shell
                php -r 'foreach (json_decode(stream_get_contents(STDIN), true) ?: [] as $f) {
                        if (is_array($f) && preg_match("/^emp-backup-[a-z0-9.-]+\\.tar\$/", (string) ($f["Path"] ?? ""))) {
                            printf("remoto\t%s\t%d\t%d\n", $f["Path"], (int) ($f["Size"] ?? 0), (int) strtotime((string) ($f["ModTime"] ?? "")));
                        }
                    }' <<<"$list" | sort -t$'\t' -k4,4nr
            else
                printf 'destinazione\t%s\t0\n' "$(remote_description)"
            fi
            remote_details_tsv
        fi
        return 0
    fi
    echo "Backup su questa macchina ($EMP_BACKUP):"
    find "$EMP_BACKUP" -maxdepth 1 -type f -name 'emp-backup-*.tar' -printf '%TY-%Tm-%Td %TH:%TM  %10s  %f\n' 2>/dev/null | sort -r | sed 's/^/  /'
    if remote_configured; then
        echo "Backup remoti ($(remote_description)):"
        rclone_emp lsl emp-cifrato: 2>/dev/null | grep 'emp-backup-' | sort -k2,3r | awk '{print "  " $2 " " substr($3,1,5) "  " $1 "  " $4}' \
            || echo "  destinazione non raggiungibile"
    fi
}

# ---------------------------------------------------------------- destinazione remota (cifrata)

# Per la pagina Backup: tipo, data del collegamento, account Google, client OAuth (mai il Client Secret).
remote_details_tsv() {
    local id
    printf 'tipo\t%s\n' "$(remote_kind)"
    printf 'dal\t%s\n' "$(remote_connected_epoch)"
    if remote_is_gdrive; then
        if [[ -f $REMOTE_DIR/account ]]; then
            printf 'account\t%s\n' "$(head -c 254 "$REMOTE_DIR/account" | head -n1)"
        elif [[ -f $REMOTE_DIR/account-errore ]]; then
            printf 'account_errore\t%s\n' "$(head -c 250 "$REMOTE_DIR/account-errore" | head -n1 | tr -d '\t')"
        fi
        id=$(remote_google_client_id)
        printf 'client\t%s\n' "${id:-predefinito}"
    fi
    return 0
}

remote_description() {
    if [[ -f $REMOTE_DIR/destinazione ]]; then cat "$REMOTE_DIR/destinazione"; else echo "destinazione remota"; fi
}

valid_google_client_id() { [[ $1 =~ ^[0-9]{4,30}-[a-z0-9]{8,64}\.apps\.googleusercontent\.com$ ]]; }
valid_google_client_secret() { [[ $1 =~ ^[A-Za-z0-9_-]{10,128}$ ]]; }
remote_is_gdrive() { [[ -f $REMOTE_CONF ]] && grep -qx 'type = drive' "$REMOTE_CONF"; }
remote_kind() {
    [[ -f $REMOTE_CONF ]] || return 0
    sed -n '/^\[emp-destinazione\]/,/^\[/s/^type = //p' "$REMOTE_CONF" | head -n1 | sed 's/^drive$/gdrive/;s/^local$/locale/'
}
remote_google_client_id() { [[ -f $REMOTE_CONF ]] && sed -n 's/^client_id = //p' "$REMOTE_CONF" | head -n1; }
# Data del collegamento: il file della descrizione si scrive solo quando si collega una destinazione.
remote_connected_epoch() { stat -c %Y "$REMOTE_DIR/destinazione" 2>/dev/null || true; }

# Account Google collegato (indirizzo email), letto da Google con il token di rclone e salvato in
# $REMOTE_DIR/account. Il permesso drive.file basta per leggere chi è l'utente (Drive API "about").
gdrive_save_account() {
    remote_is_gdrive || return 1
    local access json email code
    # shellcheck disable=SC2016  # codice PHP, non variabili della shell
    access=$(sed -n 's/^token = //p' "$REMOTE_CONF" | head -n1 | php -r '$t = json_decode(stream_get_contents(STDIN), true);
        $a = is_array($t) ? ($t["access_token"] ?? "") : ""; if (!is_string($a) || !preg_match("/^[A-Za-z0-9._~+\/=-]{10,4096}$/", $a)) { exit(1); } echo $a;') \
        || { account_error "token di Google non leggibile nella configurazione"; return 1; }
    # Il token va a curl dallo standard input, non sulla riga di comando (visibile con ps).
    json=$(printf 'header = "Authorization: Bearer %s"\n' "$access" \
        | curl -sS --max-time 15 -K - -w '\n%{http_code}' 'https://www.googleapis.com/drive/v3/about?fields=user(emailAddress)' 2>&1) \
        || { account_error "Google non raggiungibile"; return 1; }
    code=${json##*$'\n'}
    json=${json%$'\n'*}
    if [[ $code != 200 ]]; then
        # Messaggio di Google (es. API non attiva per il client OAuth proprio), senza dati sensibili.
        # shellcheck disable=SC2016  # codice PHP, non variabili della shell
        account_error "Google risponde $code: $(php -r '$j = json_decode(stream_get_contents(STDIN), true);
            echo substr(preg_replace("/[^A-Za-z0-9 .,:;()\/_-]/", "", (string) ($j["error"]["message"] ?? "")), 0, 200);' <<<"$json")"
        return 1
    fi
    # shellcheck disable=SC2016  # codice PHP, non variabili della shell
    email=$(php -r '$j = json_decode(stream_get_contents(STDIN), true); $e = $j["user"]["emailAddress"] ?? "";
        if (!is_string($e) || strlen($e) > 254 || !preg_match("/^[^\s@]+@[^\s@]+$/", $e)) { exit(1); } echo $e;' <<<"$json") \
        || { account_error "risposta di Google senza indirizzo email"; return 1; }
    printf '%s\n' "$email" > "$REMOTE_DIR/account"
    chmod 0600 "$REMOTE_DIR/account"
    rm -f -- "$REMOTE_DIR/account-errore"
}

# Perché l'account non è stato letto (mostrato nella pagina Backup al posto dell'indirizzo).
account_error() {
    printf '%s\n' "$1" > "$REMOTE_DIR/account-errore"
    chmod 0600 "$REMOTE_DIR/account-errore"
}

new_backup_key() {
    local raw
    raw=$(head -c 32 /dev/urandom | base32 -w0)   # 52 caratteri A-Z e 2-7
    echo "EMP-BK-${raw:0:6}-${raw:6:6}-${raw:12:6}-${raw:18:6}-${raw:24:6}"
}

cmd_backup_remoto() {
    require_root backup-remoto
    local action=${1:-stato}
    shift || true
    case $action in
        collega) remote_connect "$@" ;;
        stato)
            if remote_configured; then
                info "Destinazione: $(remote_description)"
                [[ -f $REMOTE_DIR/account ]] && info "Account Google: $(cat "$REMOTE_DIR/account")"
                [[ -n $(remote_connected_epoch) ]] && info "Collegata dal $(date -d "@$(remote_connected_epoch)" '+%d/%m/%Y %H:%M')"
                remote_is_gdrive && [[ -n $(remote_google_client_id) ]] && info "Client Google proprio: $(remote_google_client_id)"
                if rclone_emp lsf emp-cifrato: --files-only >/dev/null 2>&1; then info "Raggiungibile"; else echo "Avviso: non raggiungibile ora"; fi
            else
                info "Nessuna destinazione remota: sudo emp-server backup-remoto collega gdrive"
            fi ;;
        chiave) cmd_backup_chiave ;;
        scollega)
            rm -rf "$REMOTE_DIR"
            info "Destinazione remota scollegata da questa macchina (i backup già inviati restano dove sono)" ;;
        *) die "uso: emp-server backup-remoto collega gdrive [--client-id ID --client-secret-file FILE]|sftp|locale … | stato | chiave | scollega" ;;
    esac
}

remote_connect() {
    local kind=${1:-} key='' arg='' folder pw='' token_file='' password_file='' client_id='' client_secret=''
    shift || true
    while (($#)); do
        case $1 in
            --chiave) [[ $# -ge 2 ]] || die "manca la chiave dopo --chiave"; key=$2; shift 2 ;;
            # Senza terminale (pagina Backup di /techadmin): token di Google già ottenuto, password SFTP in un file.
            --token-file) [[ $# -ge 2 && -f $2 ]] || die "file del token mancante"; token_file=$2; shift 2 ;;
            --password-file) [[ $# -ge 2 && -f $2 ]] || die "file della password mancante"; password_file=$2; shift 2 ;;
            # Google Drive con un client OAuth proprio (facoltativo): Client ID e file con il Client Secret.
            --client-id) [[ $# -ge 2 ]] || die "manca il Client ID dopo --client-id"; client_id=$2; shift 2 ;;
            --client-secret-file) [[ $# -ge 2 && -f $2 ]] || die "file del Client Secret mancante"; client_secret=$(head -c 256 "$2"); shift 2 ;;
            *) arg=$1; shift ;;
        esac
    done
    if [[ -n $client_id || -n $client_secret ]]; then
        [[ $kind == gdrive ]] || die "Client ID e Client Secret valgono solo per Google Drive"
        valid_google_client_id "$client_id" || die "Client ID di Google non valido (formato NUMERI-xxxx.apps.googleusercontent.com)"
        valid_google_client_secret "$client_secret" || die "Client Secret di Google non valido"
    fi
    command -v rclone >/dev/null || die "rclone non installato: rieseguire installa.sh"
    # Una sola cartella per account: il nome del server è nel nome di ogni file, così una
    # macchina nuova vede i backup di quella vecchia e può ripristinarli.
    folder="EMP-backup"
    # Una sola chiave per macchina: senza --chiave si usa quella dei backup locali.
    if [[ -n $key ]]; then
        valid_backup_key "$key" || die "chiave dei backup non valida (formato EMP-BK-XXXXXX-…)"
    else
        key=$(backup_key)
    fi
    install -d -m 0700 -o root -g root "$REMOTE_DIR"
    local tmp
    tmp=$(mktemp "$REMOTE_DIR/.rclone-XXXXXX")
    case $kind in
        gdrive)
            if [[ -n $token_file ]]; then
                local token
                # shellcheck disable=SC2016  # codice PHP, non variabili della shell
                token=$(php -r '$t = json_decode(file_get_contents($argv[1]), true);
                    if (!is_array($t) || !isset($t["access_token"]) || !is_string($t["access_token"])) { exit(1); }
                    echo json_encode($t, JSON_UNESCAPED_SLASHES);' "$token_file") || { rm -f "$tmp"; die "token di Google non valido"; }
                {
                    printf '[emp-destinazione]\ntype = drive\nscope = drive.file\n'
                    [[ -n $client_id ]] && printf 'client_id = %s\nclient_secret = %s\n' "$client_id" "$client_secret"
                    printf 'token = %s\n\n' "$token"
                } > "$tmp"
                echo "Google Drive ($folder)" > "$REMOTE_DIR/destinazione"
            else
            echo
            echo "Collegamento a Google Drive. Serve un browser: dal PC, apri una NUOVA connessione SSH così:"
            echo
            echo "    ssh -L 53682:127.0.0.1:53682 $(id -un "${SUDO_USER:-root}" 2>/dev/null || echo utente)@$(first_private_ipv4)"
            echo
            echo "poi apri in Chrome il link http://127.0.0.1:53682/... che compare qui sotto e accedi con l'account Google dei backup."
            echo "EMP vede solo i file che crea lui su Drive (permesso drive.file), nella cartella $folder."
            echo
            rclone --config "$tmp" config create emp-destinazione drive scope=drive.file \
                ${client_id:+client_id="$client_id"} ${client_secret:+client_secret="$client_secret"} >/dev/null \
                || { rm -f "$tmp"; die "collegamento a Google Drive non riuscito"; }
            echo "Google Drive ($folder)" > "$REMOTE_DIR/destinazione"
            fi ;;
        sftp)
            [[ $arg =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || die "uso: emp-server backup-remoto collega sftp utente@host[:porta]"
            local user=${arg%@*} hostport=${arg#*@} port=22
            [[ $hostport == *:* ]] && port=${hostport##*:}
            if [[ -n $password_file ]]; then
                pw=$(head -c 512 "$password_file")
            else
                read -rs -p "Password SFTP di ${arg} (vuota per usare la chiave SSH di root): " pw; echo
            fi
            rclone --config "$tmp" config create emp-destinazione sftp host="${hostport%%:*}" user="$user" port="$port" ${pw:+pass="$pw"} --obscure >/dev/null \
                || { rm -f "$tmp"; die "configurazione SFTP non riuscita"; }
            echo "SFTP ${arg} ($folder)" > "$REMOTE_DIR/destinazione" ;;
        locale)
            # Per i test e per un disco montato (USB, NAS): cartella su questa macchina.
            [[ $arg == /* ]] || die "uso: emp-server backup-remoto collega locale /percorso/assoluto"
            install -d -m 0700 "$arg"
            rclone --config "$tmp" config create emp-destinazione local >/dev/null
            folder="$arg/EMP-backup"
            echo "Cartella $arg" > "$REMOTE_DIR/destinazione" ;;
        *) rm -f "$tmp"; die "destinazione non supportata: ${kind:-?} (gdrive, sftp, locale)" ;;
    esac
    rclone --config "$tmp" config create emp-cifrato crypt remote="emp-destinazione:$folder" password="$key" \
        filename_encryption=off directory_name_encryption=false --obscure >/dev/null
    chmod 0600 "$tmp"
    rm -f "$REMOTE_DIR/account" "$REMOTE_DIR/account-errore"
    mv "$tmp" "$REMOTE_CONF"
    change_backup_key "$key"
    rclone_emp mkdir emp-cifrato: || die "destinazione non raggiungibile"
    info "Destinazione collegata: $(remote_description)"
    if [[ $kind == gdrive ]]; then
        if gdrive_save_account; then
            info "Account Google: $(cat "$REMOTE_DIR/account")"
        else
            echo "Avviso: account Google non letto (si riprova al prossimo controllo della destinazione)"
        fi
    fi
    echo
    echo "================================================================"
    echo " CHIAVE DEI BACKUP — salvala ORA fuori da questa macchina"
    echo " (gestore di password, foglio stampato in cassaforte):"
    echo
    echo "      $key"
    echo
    echo " Senza questa chiave i backup remoti NON si possono ripristinare."
    echo " Su una macchina nuova: sudo emp-server backup-remoto collega gdrive --chiave CHIAVE"
    echo " Per rivederla da qui: sudo emp-server backup-remoto chiave"
    echo "================================================================"
}

# ---------------------------------------------------------------- ripristino

# Scarica e decifra un backup remoto nella cartella dei backup locali.
download_remote() {
    local remote=$1
    [[ $remote =~ ^emp-backup-[a-z0-9.-]+\.tar$ && $remote != *..* ]] || die "nome di backup remoto non valido (vedi: sudo emp-server backup-elenco)"
    remote_configured || die "nessuna destinazione remota collegata (sudo emp-server backup-remoto collega … --chiave CHIAVE)"
    [[ -d $EMP_BACKUP ]] || install -d -m 0750 -o root -g "$EMP_SCP_GROUP" "$EMP_BACKUP"
    info "Download e decifratura di $remote da $(remote_description)"
    rclone_emp copyto "emp-cifrato:$remote" "$EMP_BACKUP/$remote.parziale" \
        || { rm -f "$EMP_BACKUP/$remote.parziale"; die "download non riuscito (chiave sbagliata o destinazione non raggiungibile)"; }
    local part="$EMP_BACKUP/$remote.parziale"
    # Backup remoti precedenti alla 0.6.0-alpha.11: arrivano in chiaro, qui si cifrano subito.
    if ! is_encrypted_backup "$part"; then
        if ! encrypt_backup_file "$part" "$part.cifra" "$(backup_key)"; then
            rm -f -- "${part:?}" "${part:?}.cifra"
            die "cifratura del backup scaricato non riuscita"
        fi
        replace_keeping_date "$part" "$part.cifra"
    fi
    backup_file_perms "$part"
    mv "$part" "$EMP_BACKUP/$remote"
}

cmd_backup_scarica() {
    require_root backup-scarica
    [[ ${1:-} == --remoto && -n ${2:-} ]] || die "uso: sudo emp-server backup-scarica --remoto NOME (elenco: sudo emp-server backup-elenco)"
    download_remote "$2"
    info "Backup disponibile su questa macchina: $EMP_BACKUP/$2"
}

manifest_field() { sed -n "s/^$2=//p" "$1/MANIFEST" | head -n1; }

health_ok() {
    local _
    for _ in $(seq 1 30); do
        curl -fsS --max-time 5 --cacert "$EMP_TLS/ca.crt" --resolve "localhost:443:127.0.0.1" \
            https://localhost/api/v1/salute >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

cmd_ripristina() {
    require_root ripristina
    local file='' remote='' yes=0 key='' shown=''
    while (($#)); do
        case $1 in
            --remoto) [[ $# -ge 2 ]] || die "manca il nome dopo --remoto"; remote=$2; shift 2 ;;
            --chiave) [[ $# -ge 2 ]] || die "manca la chiave dopo --chiave"; key=$2; shift 2 ;;
            --si) yes=1; shift ;;
            -*) die "opzione sconosciuta: $1" ;;
            *) file=$1; shift ;;
        esac
    done
    if [[ -n $remote ]]; then
        download_remote "$remote"
        file="$EMP_BACKUP/$remote"
    fi
    [[ -n $file && -f $file ]] || die "uso: sudo emp-server ripristina FILE | --remoto NOME  (elenco: sudo emp-server backup-elenco)"

    local work
    new_temp_dir work "$EMP_DATA"
    shown=$file
    # Backup cifrato: si rimette in chiaro (nella cartella temporanea) prima di leggerlo.
    if is_encrypted_backup "$file"; then
        [[ -n $key ]] || key=$(backup_key)
        valid_backup_key "$key" || die "chiave dei backup non valida (formato EMP-BK-XXXXXX-…)"
        decrypt_backup_file "$file" "$work/backup.tar" "$key" \
            || die "il backup non si apre con questa chiave (backup di un altro server? usare --chiave CHIAVE)"
        info "Backup decifrato"
        file="$work/backup.tar"
    fi
    tar -C "$work" -xf "$file" MANIFEST SHA256SUMS database.sql.gz dati.tar.gz 2>/dev/null || die "file di backup non valido"
    local package
    package=$(manifest_field "$work" pacchetto)
    if [[ -n $package ]]; then
        [[ $package =~ ^emp-server-[0-9A-Za-z.+~-]+\.tar\.gz$ ]] || die "pacchetto non valido nel backup"
        tar -C "$work" -xf "$file" "$package" || die "pacchetto mancante nel backup"
    fi
    ( cd "$work" && sha256sum --quiet --strict -c SHA256SUMS ) || die "backup danneggiato o modificato (SHA256SUMS)"
    [[ $(manifest_field "$work" formato) == "$BACKUP_FORMAT" ]] || die "formato del backup non supportato"
    # Elenco letto per intero: con "| grep -q" e pipefail il SIGPIPE renderebbe falso il controllo.
    if tar -tzf "$work/dati.tar.gz" | grep -Ev '^(moduli|catalogo|catalogo-locale|dati-moduli)(/|$)' | grep . >/dev/null; then
        die "il backup contiene percorsi non ammessi"
    fi

    local bserver bcore current
    bserver=$(manifest_field "$work" emp_server)
    bcore=$(manifest_field "$work" core)
    current=$(installed_server_version)
    echo
    echo "Backup:      $(basename "$shown")"
    echo "             creato il $(manifest_field "$work" creato) sulla macchina $(manifest_field "$work" macchina)"
    echo "             EMP Server ${bserver}, Core ${bcore}"
    echo "Questa macchina: $(host_name), EMP Server ${current:-non installato}"
    echo
    echo "Database, Core, plugin e cataloghi di EMP verranno SOSTITUITI da quelli del backup."
    echo "Restano di questa macchina: nome, certificato HTTPS, collegamento a GitHub e ai backup remoti."
    if [[ -z $package && $bserver != "$current" ]]; then
        die "il backup non contiene il pacchetto di EMP Server ${bserver:-?}: installare prima quella versione"
    fi
    if ((!yes)); then
        local answer
        read -r -p "Scrivi RIPRISTINA per continuare: " answer
        [[ $answer == RIPRISTINA ]] || die "annullato: nessuna modifica"
    fi

    if emp_database_exists && [[ -f $EMP_MODULES/emp-core/emp-module.json ]]; then
        info "Backup di sicurezza dello stato attuale, prima di sostituirlo"
        cmd_backup --etichetta prima-del-ripristino || [[ $? -eq 3 ]] || die "backup di sicurezza non riuscito: ripristino annullato"
    fi

    local fpm
    fpm="php$(php_version)-fpm"
    systemctl stop emp-backup.timer nginx "$fpm" 2>/dev/null || true

    mariadb <<'SQL'
DROP DATABASE IF EXISTS emp;
CREATE DATABASE emp CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS 'emp'@'localhost' IDENTIFIED VIA unix_socket;
GRANT ALL PRIVILEGES ON emp.* TO 'emp'@'localhost';
FLUSH PRIVILEGES;
SQL
    gunzip -c "$work/database.sql.gz" | mariadb emp || die "importazione del database non riuscita"
    info "Database ripristinato"

    local d
    # shellcheck disable=SC2086  # elenco fisso di cartelle
    for d in $EMP_DATA_DIRS; do rm -rf "${EMP_DATA:?}/$d"; done
    tar -C "$EMP_DATA" -xzf "$work/dati.tar.gz" --same-owner
    create_dirs
    info "Core, plugin e cataloghi ripristinati"

    if [[ -n $package && $bserver != "$current" ]]; then
        info "Installazione di EMP Server ${bserver} dal backup (programmi e configurazione dei servizi)"
        mkdir "$work/pacchetto"
        tar -C "$work/pacchetto" -xzf "$work/$package"
        local dir
        dir=$(find "$work/pacchetto" -mindepth 1 -maxdepth 1 -type d -name 'emp-server-*' | head -n1)
        [[ -x $dir/installa.sh ]] || die "pacchetto del backup non valido"
        EMP_RIPRISTINO=1 "$dir/installa.sh" | sed 's/^/  /'
    else
        systemctl start "$fpm" nginx
        core_cli installa --utente=installer | sed 's/^/  /'
    fi
    apply_backup_timer
    health_ok || die "il Core non risponde dopo il ripristino: controllare $EMP_LOGS"
    echo
    info "Ripristino completato: EMP Server ${bserver}, Core ${bcore}, dati del $(manifest_field "$work" creato)"
}

cmd_moduli() {
    require_root moduli
    core_cli elenco
    boot_status_lines
}

# ---------------------------------------------------------------- plugin fermi (recupero)
#
# Se un plugin blocca EMP (pagine che non si aprono, "Servizio non disponibile"), dalla console:
#   sudo emp-server plugin-disattiva NOME     ferma solo quel plugin (e chi dipende da lui)
#   sudo emp-server avvio-sicuro              ferma tutti i plugin: si avvia solo il Core
# Il plugin resta installato con i suoi dati; il Core legge /etc/emp/avvio.conf a ogni richiesta,
# quindi l'effetto è immediato, senza riavvii. Il file è della macchina: non va nei backup.

readonly BOOT_CONF=$EMP_CONF_DIR/avvio.conf
BOOT_SAFE=no
BOOT_DISABLED=()

valid_plugin_id() { [[ $1 =~ ^[a-z][a-z0-9-]{2,63}$ && $1 != emp-core ]]; }

load_boot_conf() {
    BOOT_SAFE=no
    BOOT_DISABLED=()
    [[ -f $BOOT_CONF ]] || return 0
    local key value id ids
    while IFS='=' read -r key value; do
        case $key in
            AVVIO_SICURO) [[ $value == si ]] && BOOT_SAFE=si ;;
            DISATTIVATI)
                IFS=',' read -ra ids <<<"$value"
                for id in "${ids[@]}"; do valid_plugin_id "$id" && BOOT_DISABLED+=("$id"); done ;;
        esac
    done < "$BOOT_CONF"
    return 0
}

save_boot_conf() {
    local tmp list
    list=$(printf '%s\n' "${BOOT_DISABLED[@]}" | sed '/^$/d' | sort -u | paste -sd, -)
    if [[ $BOOT_SAFE == no && -z $list ]]; then
        rm -f "$BOOT_CONF"
        return 0
    fi
    install -d -m 0755 -o root -g root "$EMP_CONF_DIR"
    tmp=$(mktemp "$EMP_CONF_DIR/.avvio-XXXXXX")
    {
        echo "# EMP Server — avvio dei plugin (emp-server plugin-disattiva / plugin-riattiva / avvio-sicuro)"
        echo "AVVIO_SICURO=$BOOT_SAFE"
        echo "DISATTIVATI=$list"
    } > "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$BOOT_CONF"
}

boot_is_disabled() {
    local id
    for id in "${BOOT_DISABLED[@]}"; do [[ $id == "$1" ]] && return 0; done
    return 1
}

boot_status_lines() {
    load_boot_conf
    [[ $BOOT_SAFE == si ]] && echo "  AVVIO SICURO attivo: si avvia solo il Core (per tornare al normale: sudo emp-server avvio-sicuro --fine)"
    local id
    for id in "${BOOT_DISABLED[@]}"; do
        echo "  $id: disattivato dalla console (sudo emp-server plugin-riattiva $id)"
    done
    return 0
}

# Il plugin deve risultare installato; se il Core non risponde nemmeno da console, si procede lo stesso.
require_installed_plugin() {
    local list
    if list=$(core_cli elenco 2>/dev/null); then
        grep -q "^$1 " <<<"$list" || die "plugin non installato: $1 (elenco: sudo emp-server moduli)"
    else
        echo "Avviso: elenco dei moduli non disponibile, $1 non verificato"
    fi
}

cmd_plugin_disattiva() {
    require_root plugin-disattiva
    local id=${1:-}
    valid_plugin_id "$id" || die "uso: sudo emp-server plugin-disattiva NOME (es. emp-esempio; il Core non si può fermare)"
    require_installed_plugin "$id"
    load_boot_conf
    if boot_is_disabled "$id"; then
        info "$id è già disattivato"
        return 0
    fi
    BOOT_DISABLED+=("$id")
    save_boot_conf
    info "$id disattivato: resta installato con i suoi dati, ma non si avvia (nemmeno chi dipende da lui)"
    echo "Per riattivarlo: sudo emp-server plugin-riattiva $id"
}

cmd_plugin_riattiva() {
    require_root plugin-riattiva
    local id=${1:-} kept=() d
    valid_plugin_id "$id" || die "uso: sudo emp-server plugin-riattiva NOME"
    load_boot_conf
    boot_is_disabled "$id" || { info "$id non è disattivato"; return 0; }
    for d in "${BOOT_DISABLED[@]}"; do [[ $d == "$id" ]] || kept+=("$d"); done
    BOOT_DISABLED=("${kept[@]}")
    save_boot_conf
    info "$id riattivato"
    [[ $BOOT_SAFE == si ]] && echo "Avviso: è attivo l'avvio sicuro, i plugin restano fermi finché non dai: sudo emp-server avvio-sicuro --fine"
    return 0
}

cmd_avvio_sicuro() {
    require_root avvio-sicuro
    load_boot_conf
    case ${1:-} in
        '')
            BOOT_SAFE=si
            save_boot_conf
            info "Avvio sicuro attivo: si avvia solo il Core, tutti i plugin sono fermi (installati, dati compresi)"
            echo "Ora le pagine /techadmin e /admin si aprono. Per trovare il plugin che blocca:"
            echo "  sudo emp-server plugin-disattiva NOME, poi sudo emp-server avvio-sicuro --fine"
            ;;
        --fine)
            BOOT_SAFE=no
            save_boot_conf
            info "Avvio normale: si avviano tutti i plugin installati${BOOT_DISABLED[*]:+, tranne quelli disattivati (${BOOT_DISABLED[*]})}"
            ;;
        *) die "uso: sudo emp-server avvio-sicuro [--fine]" ;;
    esac
}

# ---------------------------------------------------------------- total reset (clone del master)
#
# Procedura white label: una VM "master" resta aggiornata all'ultima release e in stato di
# fabbrica; per ogni nuovo cliente se ne fa un clone completo in VMware e, sul clone:
#   sudo emp-server azzera --nome NOME-CLIENTE
# Cancella TUTTI i dati di EMP (database, plugin, catalogo locale, backup, registri) e dà al
# clone un'identità propria: nome host, identificativo della macchina, chiavi SSH, autorità di
# certificazione e certificato HTTPS. Il collegamento a GitHub ereditato dal master viene tolto
# SOLO da questa macchina (su GitHub il runner del master resta registrato): per collegare il
# clone, sudo emp-server collega-github. Restano Ubuntu, i pacchetti e il Core installato.

valid_server_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,39}[a-z0-9]$ ]]; }

# Toglie da questa macchina il runner GitHub copiato dal master, senza deregistrarlo da GitHub
# (config.sh remove cancellerebbe il runner del master, che usa le stesse credenziali).
detach_runner() {
    if [[ ! -d $RUNNER_DIR ]]; then
        info "Nessun collegamento a GitHub su questa macchina"
        return 0
    fi
    if [[ -f $RUNNER_DIR/.service ]]; then
        ( cd "$RUNNER_DIR" && { ./svc.sh stop >/dev/null 2>&1 || true; ./svc.sh uninstall >/dev/null 2>&1 || true; } )
    fi
    rm -rf "$RUNNER_DIR"
    info "Collegamento a GitHub copiato dal master rimosso da questa macchina"
}

new_system_identity() {
    local name=$1
    hostnamectl set-hostname "$name"
    if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
        sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t${name}/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$name" >> /etc/hosts
    fi
    # cloud-init non deve rimettere il nome del master al prossimo avvio.
    if [[ -d /etc/cloud/cloud.cfg.d ]]; then
        printf '# EMP Server: nome host impostato da emp-server azzera\npreserve_hostname: true\n' > /etc/cloud/cloud.cfg.d/99-emp-nome.cfg
    fi
    # Identificativo casuale: systemd-machine-id-setup potrebbe riusare l'UUID della VM.
    rm -f /var/lib/dbus/machine-id
    tr -d '-' < /proc/sys/kernel/random/uuid > /etc/machine-id
    chmod 0444 /etc/machine-id
    [[ -d /var/lib/dbus ]] && ln -sf /etc/machine-id /var/lib/dbus/machine-id
    info "Nome host: ${name}; nuovo identificativo della macchina"
    if compgen -G '/etc/ssh/ssh_host_*' >/dev/null; then
        rm -f /etc/ssh/ssh_host_*
        ssh-keygen -A >/dev/null
        systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
        info "Nuove chiavi SSH (chi si collegava in SSH vedrà un avviso di chiave cambiata: è normale)"
    fi
}

wipe_emp_data() {
    local fpm
    fpm="php$(php_version)-fpm"
    systemctl stop emp-backup.timer emp-certificato.timer nginx "$fpm" 2>/dev/null || true

    mariadb <<'SQL'
DROP DATABASE IF EXISTS emp;
CREATE DATABASE emp CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS 'emp'@'localhost' IDENTIFIED VIA unix_socket;
GRANT ALL PRIVILEGES ON emp.* TO 'emp'@'localhost';
FLUSH PRIVILEGES;
SQL
    info "Database emp svuotato"

    # Moduli: resta solo il Core; via plugin installati, caricati, backup e versioni precedenti.
    find "$EMP_MODULES" -mindepth 1 -maxdepth 1 ! -name emp-core -exec rm -rf -- {} +
    rm -rf "$EMP_DATA/catalogo-locale" "$EMP_DATA/tmp" "$EMP_BACKUP" "$EMP_DATA/precedenti" "$EMP_DATA/arrivi" \
        "$EMP_DATA/pubblico/emp-ca.crt" "$EMP_DATA"/.core-* "$EMP_DATA/backup-web" "$EMP_DATA/scaricamenti"
    create_dirs
    info "Dati, plugin, catalogo locale e backup di prova cancellati"

    find "$EMP_LOGS" -mindepth 1 -type f -delete
    rm -f /var/log/nginx/emp-*
    journalctl --rotate >/dev/null 2>&1 || true
    journalctl --vacuum-time=1s >/dev/null 2>&1 || true
    info "Registri di prova cancellati"

    # Identità HTTPS, nome DNS aggiuntivo e destinazione dei backup remoti appartengono alla macchina d'origine.
    # Anche le impostazioni dei backup: il clone riparte da quelle predefinite.
    rm -rf "$EMP_TLS" "$REMOTE_DIR" "$BACKUP_TIMER_DROPIN_DIR"
    rm -f "$EMP_CONF_DIR/nome-dns" "$BACKUP_CONF" "$EMP_CONF_DIR/avvio.conf" "$BACKUP_KEY_FILE"
    systemctl daemon-reload 2>/dev/null || true
    if [[ -f $EMP_CONF_DIR/github.conf ]]; then
        sed -i -E 's/^EMP_NOME_DNS=.*/EMP_NOME_DNS=/' "$EMP_CONF_DIR/github.conf"
    fi
}

cmd_azzera() {
    require_root azzera
    local name='' yes=0 answer fpm _
    while (($#)); do
        case $1 in
            --nome) [[ $# -ge 2 ]] || die "manca il nome dopo --nome"; name=$2; shift 2 ;;
            --si) yes=1; shift ;;
            *) die "opzione sconosciuta: $1" ;;
        esac
    done
    name=$(tr '[:upper:]' '[:lower:]' <<<"$name")
    [[ -n $name ]] || die "uso: sudo emp-server azzera --nome NOME-DEL-SERVER"
    valid_server_name "$name" || die "nome non valido: ${name} (lettere minuscole, cifre e trattini, da 2 a 41 caratteri, senza trattino iniziale o finale)"
    [[ -f $EMP_CONFIG && -f $EMP_MODULES/emp-core/emp-module.json ]] || die "EMP Server non è installato su questa macchina"

    cat <<EOF

TOTAL RESET di EMP Server — operazione IRREVERSIBILE.

Su QUESTA macchina ($(host_name)) verranno cancellati:
  - database emp: utenti, Amministratore Tecnico, Recovery Key, dati, registro delle operazioni;
  - plugin installati e caricati, backup, registri di EMP;
  - autorità di certificazione e certificato HTTPS (le postazioni dovranno installare quella nuova);
  - collegamento a GitHub copiato dal master.
Il Server prenderà il nome "${name}", un nuovo identificativo e nuove chiavi SSH.

Usare SOLO su un clone. Sulla macchina master NON va eseguito.
Prima: istantanea o copia della VM in VMware.

EOF
    if ((yes == 0)); then
        [[ -t 0 ]] || die "conferma richiesta: eseguire dalla console della VM (oppure aggiungere --si)"
        read -r -p "Per confermare scrivere: AZZERA ${name}  > " answer
        [[ $answer == "AZZERA ${name}" ]] || die "annullato: nessuna modifica"
    fi

    echo "==> Scollegamento da GitHub"
    detach_runner
    echo "==> Cancellazione dei dati di EMP"
    wipe_emp_data
    echo "==> Nuova identità della macchina"
    new_system_identity "$name"
    echo "==> Nuova autorità di certificazione e certificato HTTPS"
    cmd_certificato
    echo "==> Core sul database vuoto"
    core_cli installa --utente=installer | sed 's/^/  /'
    fpm="php$(php_version)-fpm"
    systemctl start "$fpm" nginx
    systemctl start emp-backup.timer emp-certificato.timer
    systemctl restart emp-backup-web.path 2>/dev/null || true   # cartella delle richieste ricreata
    for _ in $(seq 1 30); do
        if curl -fsS --max-time 5 --cacert "$EMP_TLS/ca.crt" --resolve "localhost:443:127.0.0.1" \
            https://localhost/api/v1/salute >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    curl -fsS --max-time 5 --cacert "$EMP_TLS/ca.crt" --resolve "localhost:443:127.0.0.1" \
        https://localhost/api/v1/salute >/dev/null 2>&1 || die "il Core non risponde: sudo emp-server stato"

    local code ip
    code=$(core_cli codice-setup | sed -n 's/^Codice di setup: //p')
    echo
    echo "================================================================"
    echo " Server \"${name}\" azzerato: pronto per il primo setup"
    echo "================================================================"
    echo
    echo " 1) Su ogni PC del negozio togliere la vecchia autorità \"EMP CA locale\" e installare la nuova:"
    for ip in $(private_ipv4); do echo "      http://${ip}/emp-ca.crt"; done
    echo "    Impronta SHA-256 da confrontare:"
    echo "      $(ca_fingerprint)"
    echo
    echo " 2) Primo setup dell'Amministratore Tecnico — codice monouso (valido 24 ore):"
    echo
    echo "      ${code}"
    echo
    for ip in $(private_ipv4); do echo "      https://${ip}/techadmin/setup.html"; done
    echo
    echo " 3) Per aggiornarlo da GitHub:  sudo emp-server collega-github"
    echo
    echo " Consigliato: riavviare la VM (sudo reboot). Se dopo il riavvio l'indirizzo IP cambia,"
    echo " riservarlo nel router: il certificato si aggiorna da solo (oppure: sudo emp-server certificato)."
    echo
}

# ---------------------------------------------------------------- collegamento a GitHub

cmd_collega_github() {
    require_root collega-github
    local script=$EMP_HOME/github/prepara-runner.sh
    [[ -x $script ]] || die "script di collegamento mancante ($script): aggiornare EMP Server"
    # Nome ed etichetta del runner = nome del Server: ogni negozio si sceglie da GitHub per nome.
    "$script" --nome "$(host_name)" --etichetta "$(host_name)" "$@"
}

usage() {
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
    local cmd=${1:-}
    shift || true
    case $cmd in
        stato) cmd_stato "$@" ;;
        indirizzi) cmd_indirizzi ;;
        codice-setup) cmd_codice_setup ;;
        recupero-tecnico) cmd_recupero_tecnico "$@" ;;
        certificato) cmd_certificato "$@" ;;
        backup) cmd_backup "$@" ;;
        backup-elenco) cmd_backup_elenco "$@" ;;
        backup-impostazioni) cmd_backup_impostazioni "$@" ;;
        backup-scarica) cmd_backup_scarica "$@" ;;
        backup-remoto) cmd_backup_remoto "$@" ;;
        backup-chiave) cmd_backup_chiave ;;
        backup-decifra) cmd_backup_decifra "$@" ;;
        ripristina) cmd_ripristina "$@" ;;
        accesso-scp) cmd_accesso_scp "$@" ;;
        elimina-vecchio-utente) cmd_elimina_vecchio_utente "$@" ;;
        sistema) cmd_sistema "$@" ;;
        moduli) cmd_moduli ;;
        plugin-disattiva) cmd_plugin_disattiva "$@" ;;
        plugin-riattiva) cmd_plugin_riattiva "$@" ;;
        avvio-sicuro) cmd_avvio_sicuro "$@" ;;
        azzera) cmd_azzera "$@" ;;
        collega-github) cmd_collega_github "$@" ;;
        -h | --help | aiuto | '') usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

# Le funzioni sono riusate da installa.sh (source) senza eseguire main.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
